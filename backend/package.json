{
  "name": "beverage-co-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "audit": "npm audit --audit-level=high",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next-auth": "4.24.7",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "zod": "3.23.8",
    "nanoid": "5.0.7",
    "svix": "1.24.0"
  },
  "devDependencies": {
    "prisma": "5.19.1",
    "typescript": "5.5.4",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/bcryptjs": "2.4.6",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "vitest": "2.0.5",
    "tsx": "4.19.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}