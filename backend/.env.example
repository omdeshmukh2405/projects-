# Copy to .env.local for development. Never commit the real .env file.
# Use separate values per environment (development / staging / production) —
# see SECURITY.md #51.

# --- Database (least-privilege application role, not an admin credential) ---
DATABASE_URL="postgresql://beverageco_app:CHANGE_ME@localhost:5432/beverageco?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Google OAuth (optional sign-in provider) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- CSRF / same-origin enforcement (lib/csrf.ts) ---
# Comma-separated list of exact origins allowed to call mutating API routes.
APP_ORIGIN="http://localhost:3000"

# --- Payment provider webhook (app/api/v1/webhooks/payment/route.ts) ---
PAYMENT_WEBHOOK_SECRET="generate-a-long-random-value-and-register-it-with-your-provider"

# --- Transactional email (signup verification, password reset) ---
EMAIL_FROM="Beverage Co. <no-reply@beverageco.example>"
EMAIL_PROVIDER_API_KEY=""
